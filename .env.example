# ---- Used by root-level config.py / database.py / tester.py / tasks/* ----
GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ---- Used by app/core/config.py (FastAPI settings) - same .env file ----
JWT_SECRET_KEY=generate-a-long-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=generate-with-python--c-fernet-generate-key

FRONTEND_URL=http://localhost:3000
FRONTEND_OAUTH_SUCCESS_PATH=/auth/callback

# Only needed if/when worker.py's Celery setup is actually used - the AI
# pipeline currently runs inline during /gmail/{id}/sync, not through Celery.
REDIS_URL=your_upstash_redis_url_here

ENVIRONMENT=development

# ---- Used by test/test_gmail_e2e.py (only needed to run that test) ----
# E2E_ACCESS_TOKEN=
# E2E_CONNECTION_ID=
# E2E_CONFIRM_SEND=yes

# ---- Used by frontend (Dev 3) ----
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000
